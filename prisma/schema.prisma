generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  name             String
  email            String             @unique
  password         String?
  image            String?
  role             String             @default("student")
  status           String             @default("active") // "active" | "banned" — chequeado al postear en el foro
  stripeCustomerId String?
  phone            String?
  country          String?
  city             String?
  job              String?
  bio              String?
  interests        String[]           @default([])
  enrollments      Enrollment[]
  payments         Payment[]
  conversations    Conversation[]
  materialProgress MaterialProgress[]
  forumTopics      ForumTopic[]
  forumPosts       ForumPost[]
  forumLikes       ForumLike[]
  notifications    Notification[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Course {
  id                 String              @id @default(cuid())
  title              String
  titleEn            String? // override en inglés — si es null, se usa title
  slug               String              @unique
  shortDesc          String
  shortDescEn        String? // override en inglés — si es null, se usa shortDesc
  description        String
  descriptionEn      String? // override en inglés — si es null, se usa description
  price              Float
  currency           String              @default("USD")
  stripePriceId      String?
  stripeProductId    String?
  thumbnail          String?
  isPublished        Boolean             @default(false)
  isFree             Boolean             @default(false)
  totalHours         Float? // intensidad horaria total del programa
  durationWeeks      Int? // duración estimada en semanas
  videoUrl           String? // link de YouTube mostrado en la página del programa
  content            String? // JSON: eyebrow/duración/modalidad/nivel/módulos/incluye/para quién/resultado
  enrollments        Enrollment[]
  materials          Material[]
  liveSessions       LiveSession[]
  payments           Payment[]
  conversations      Conversation[]
  exclusiveResources ExclusiveResource[]
  forumCategories    ForumCategory[]
  accreditations     Accreditation[]
  courseModules      CourseModule[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// Metadata de un "módulo" (nombre + descripción) — Material.moduleNumber
// sigue siendo el vínculo real (Int suelto, sin FK), a propósito: así un
// curso sin filas acá sigue funcionando igual que hoy (cae al label
// genérico "Módulo N"), y no hace falta backfillear ninguna fila de
// Material existente para adoptar esto curso por curso.
model CourseModule {
  id              String          @id @default(cuid())
  courseId        String
  number          Int
  title           String
  description     String?
  isVisible       Boolean         @default(true)
  course          Course          @relation(fields: [courseId], references: [id])
  forumCategories ForumCategory[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([courseId, number])
}

model Enrollment {
  id                String       @id @default(cuid())
  userId            String
  courseId          String
  status            String       @default("active")
  progress          Int          @default(0) // % de avance 0-100
  hoursCompleted    Float        @default(0) // horas realizadas
  completedAt       DateTime?
  certificateNumber String?      @unique
  certificateUrl    String?
  user              User         @relation(fields: [userId], references: [id])
  course            Course       @relation(fields: [courseId], references: [id])
  attendances       Attendance[]
  enrolledAt        DateTime     @default(now())

  @@unique([userId, courseId])
}

model Material {
  id               String             @id @default(cuid())
  courseId         String
  title            String
  description      String?
  type             String
  fileUrl          String?
  videoUrl         String?
  linkUrl          String?
  moduleNumber     Int                @default(1)
  order            Int                @default(0)
  isVisible        Boolean            @default(true)
  content          String? // JSON: ContentBlock[] — ver lib/materials-content.ts
  quizData         String? // JSON: QuizQuestion[] — solo interactionKind:"quiz"
  interactionKind  String? // "reflection" | "quiz" | null
  toolHref         String? // ej "/aula/jewgalkids?tab=valores"
  estimatedMinutes Int? // tiempo estimado de lectura/actividad
  coverImageUrl    String? // portada custom (ej. tapa de un workbook) — si está seteada, la UI reemplaza la caja genérica de descarga por la tarjeta enriquecida
  groupLabel       String? // agrupa visualmente en el sidebar de la lección (ej. "Material de estudio"); null = ítem flat
  course           Course             @relation(fields: [courseId], references: [id])
  progress         MaterialProgress[]
  createdAt        DateTime           @default(now())
}

model MaterialProgress {
  id          String    @id @default(cuid())
  userId      String
  materialId  String
  completedAt DateTime?
  response    String? // texto libre, solo interactionKind:"reflection"
  quizScore   Int?
  quizTotal   Int?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  material    Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
}

model LiveSession {
  id           String       @id @default(cuid())
  courseId     String
  title        String
  description  String?
  scheduledAt  DateTime
  durationMin  Int          @default(90) // duración en minutos (para sumar horas)
  joinUrl      String?
  recordingUrl String?
  isCompleted  Boolean      @default(false)
  course       Course       @relation(fields: [courseId], references: [id])
  attendances  Attendance[]
  createdAt    DateTime     @default(now())
}

model Attendance {
  id            String      @id @default(cuid())
  enrollmentId  String
  liveSessionId String
  status        String      @default("present") // present | absent | late
  enrollment    Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  liveSession   LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([enrollmentId, liveSessionId])
}

model Payment {
  id              String    @id @default(cuid())
  userId          String
  courseId        String
  stripeSessionId String?
  stripePaymentId String?
  amount          Float
  currency        String    @default("USD")
  status          String    @default("pending")
  paidAt          DateTime?
  user            User      @relation(fields: [userId], references: [id])
  course          Course    @relation(fields: [courseId], references: [id])
  createdAt       DateTime  @default(now())
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  category    String
  excerpt     String
  content     String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Conversation {
  id        String        @id @default(cuid())
  userId    String
  courseId  String?
  title     String?
  user      User          @relation(fields: [userId], references: [id])
  course    Course?       @relation(fields: [courseId], references: [id])
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String       @db.Text
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  createdAt      DateTime     @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String? // null = notificación admin/global (comportamiento actual); con valor = dirigida a un alumno
  type      String // "duplicate_purchase_blocked" | "refund_synced" | "payment_received" | "forum_reply"
  message   String
  metadata  String? // JSON con datos extra (email, curso, monto, etc.)
  isRead    Boolean  @default(false)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ExclusiveResource {
  id          String   @id @default(cuid())
  courseId    String?
  title       String
  description String?
  type        String // "audio" | "video" | "document"
  fileUrl     String
  duration    Int? // segundos
  isVisible   Boolean  @default(true)
  order       Int      @default(0)
  course      Course?  @relation(fields: [courseId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ForumCategory {
  id          String        @id @default(cuid())
  courseId    String? // null = categoría general, no ligada a un programa
  moduleId    String? // opcional: liga la categoría a un módulo puntual (ej. "Foro de dudas" de esa unidad)
  name        String
  description String?
  order       Int           @default(0)
  isVisible   Boolean       @default(true)
  course      Course?       @relation(fields: [courseId], references: [id])
  module      CourseModule? @relation(fields: [moduleId], references: [id])
  topics      ForumTopic[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ForumTopic {
  id         String        @id @default(cuid())
  categoryId String
  userId     String
  title      String
  isPinned   Boolean       @default(false)
  isVisible  Boolean       @default(true)
  category   ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id])
  posts      ForumPost[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt // se pisa con cada respuesta nueva, para ordenar "más reciente"

  @@index([categoryId])
}

model ForumPost {
  id        String      @id @default(cuid())
  topicId   String
  userId    String
  parentId  String? // una sola profundidad de anidado — ver resolveReplyParent en la ruta de creación
  body      String      @db.Text
  isVisible Boolean     @default(true)
  topic     ForumTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])
  parent    ForumPost?  @relation("ForumPostReplies", fields: [parentId], references: [id])
  replies   ForumPost[] @relation("ForumPostReplies")
  likes     ForumLike[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([topicId])
}

model ForumLike {
  id        String    @id @default(cuid())
  userId    String
  postId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([userId, postId])
}

// Avales/certificaciones externas (ej. FGU, CEL, APC, IDC vía Global Coaching
// Federation) — distinto del logo institucional único en CertificateDesign.
// Cada aval puede aplicar a varios programas y viceversa.
model Accreditation {
  id        String   @id @default(cuid())
  code      String   @unique // sigla corta, ej. "FGU"
  name      String // nombre completo, ej. "Florida Global University"
  logoUrl   String?
  order     Int      @default(0)
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
